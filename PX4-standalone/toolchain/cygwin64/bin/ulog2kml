#!/usr/bin/python3.6
# EASY-INSTALL-ENTRY-SCRIPT: 'pyulog==0.7.0','console_scripts','ulog2kml'
__requires__ = 'pyulog==0.7.0'
import re
import sys
from pkg_resources import load_entry_point

if __name__ == '__main__':
    sys.argv[0] = re.sub(r'(-script\.pyw?|\.exe)?$', '', sys.argv[0])
    sys.exit(
        load_entry_point('pyulog==0.7.0', 'console_scripts', 'ulog2kml')()
    )
